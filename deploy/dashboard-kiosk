#!/bin/bash
# Fullscreen Firefox on the dashboard, with its own profile. Restarts the browser if it exits.
URL=${DASHBOARD_URL:-http://localhost:8001/}
PROFILE=${XDG_DATA_HOME:-$HOME/.local/share}/dashboard/firefox
mkdir -p "$PROFILE"
cp -f "$HOME/apps/dashboard/deploy/user.js" "$PROFILE/user.js"

until curl -sf -o /dev/null "$URL"; do sleep 2; done
while true; do
    firefox --kiosk --no-remote --profile "$PROFILE" "$URL"
    sleep 3
done
